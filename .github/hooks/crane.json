        "timeoutSec": 120,
        "type": "command"
      }
    ],
    "userPromptSubmitted": [
      {
        "bash": "crane agent hook --event user-prompt-submit --profile copilot",
        "powershell": "crane agent hook --event user-prompt-submit --profile copilot",
        "timeoutSec": 120,
        "type": "command"
      }
    ]
